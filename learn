w.WriteHeader(401)            // задает HTTP-код ошибки (Unauthorized — юзер не ввел пароль)
w.WriteHeader(403)            // задает HTTP-код ошибки (Forbidden — юзеру сюда запрещено заходить)
w.WriteHeader(404)            // задает HTTP-код ошибки (Not Found — такой страницы или юзера нет)
w.WriteHeader(500)            // задает HTTP-код ошибки (Internal Server Error — сломался код на сервере)
w.Header().Set("K", "V")      // жестко заменяет заголовок, например ("Content-Type", "text/html")
w.Header().Add("K", "V")      // добавляет еще одно значение к существующему заголовку
w.Header().Del("K")           // полностью удаляет конкретный заголовок из ответа
